{
	"info": {
		"_postman_id": "v6-gateway-api-collection",
		"name": "V6 Gateway API",
		"description": "Comprehensive API collection for V6 Gateway System with multi-tenancy support.\n\n## Features\n- Multi-tenant architecture with domain-based isolation\n- Platform-specific resources (Web/Mobile)\n- JWT authentication\n- Automatic token management\n\n## Getting Started\n1. Import the environment file: `postman_environment.json`\n2. Update `tenant_domain` in environment to your tenant subdomain\n3. Run the Sign In request to get an access token\n4. The token will be automatically saved and used in subsequent requests",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global pre-request script",
					"// Add any global setup here"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global test script",
					"pm.test('Response time is less than 2000ms', function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(2000);",
					"});",
					"",
					"pm.test('Response has correct content type', function () {",
					"    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
					"});"
				]
			}
		}
	],
	"item": [
		{
			"name": "System API (Tenant)",
			"description": "Tenant-specific system endpoints. Requires tenant domain and authentication.",
			"item": [
				{
					"name": "Authentication",
					"description": "User authentication endpoints for sign up, sign in, and sign out",
					"item": [
						{
							"name": "Sign Up",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"if (pm.response.code === 200 || pm.response.code === 201) {",
											"    const jsonData = pm.response.json();",
											"    ",
											"    pm.test('Sign up successful', function () {",
											"        pm.expect(jsonData).to.have.property('data');",
											"        pm.expect(jsonData.data).to.have.property('name');",
											"        pm.expect(jsonData.data).to.have.property('email');",
											"    });",
											"    ",
											"    // Save tenant info if available",
											"    if (jsonData.data && jsonData.data.tenant) {",
											"        pm.environment.set('tenant_id', jsonData.data.tenant.id);",
											"        console.log('Tenant created:', jsonData.data.tenant.name);",
											"    }",
											"}"
										],
										"type": "text/javascript"
									}
								}
							],
							"request": {
								"auth": {
									"type": "noauth"
								},
								"method": "POST",
								"header": [
									{
										"key": "X-Platform",
										"value": "{{platform}}",
										"type": "text"
									},
									{
										"key": "Content-Type",
										"value": "application/json",
										"type": "text"
									},
									{
										"key": "Accept",
										"value": "application/json",
										"type": "text"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"john@gmail.com\",\n    \"password\": \"Pass@123\",\n    \"tenant_name\": \"Acme Corporation\",\n    \"tenant_description\": \"Acme Corporation is a leading provider of innovative solutions in the technology sector, specializing in enterprise software development and cloud infrastructure services.\",\n    \"tenant_subdomain\": \"acme\"\n}"
								},
								"url": {
									"raw": "http://{{base_url}}/api/{{api_version}}/system/auth/sign/up",
									"protocol": "http",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"{{api_version}}",
										"system",
										"auth",
										"sign",
										"up"
									]
								},
								"description": "Register a new user and create a tenant. This endpoint does not require authentication or tenancy middleware."
							},
							"response": []
						},
						{
							"name": "Sign In",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"if (pm.response.code === 200) {",
											"    const jsonData = pm.response.json();",
											"    ",
											"    pm.test('Login successful', function () {",
											"        pm.expect(jsonData).to.have.property('data');",
											"        pm.expect(jsonData.data).to.have.property('token');",
											"        pm.expect(jsonData.data).to.have.property('name');",
											"        pm.expect(jsonData.data).to.have.property('email');",
											"    });",
											"    ",
											"    // Save the access token",
											"    if (jsonData.data && jsonData.data.token) {",
											"        pm.environment.set('access_token', jsonData.data.token);",
											"        console.log('Access token saved');",
											"    }",
											"    ",
											"    // Save tenant info if available",
											"    if (jsonData.data && jsonData.data.tenant) {",
											"        pm.environment.set('tenant_id', jsonData.data.tenant.id);",
											"    }",
											"} else {",
											"    pm.test('Login failed - check credentials', function () {",
											"        pm.expect.fail('Login request failed with status ' + pm.response.code);",
											"    });",
											"}"
										],
										"type": "text/javascript"
									}
								}
							],
							"request": {
								"auth": {
									"type": "noauth"
								},
								"method": "POST",
								"header": [
									{
										"key": "X-Platform",
										"value": "{{platform}}",
										"type": "text"
									},
									{
										"key": "Content-Type",
										"value": "application/json",
										"type": "text"
									},
									{
										"key": "Accept",
										"value": "application/json",
										"type": "text"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"email\": \"john@gmail.com\",\n    \"password\": \"Pass@123\"\n}"
								},
								"url": {
									"raw": "http://{{tenant_domain}}/api/{{api_version}}/system/auth/sign/in",
									"protocol": "http",
									"host": [
										"{{tenant_domain}}"
									],
									"path": [
										"api",
										"{{api_version}}",
										"system",
										"auth",
										"sign",
										"in"
									]
								},
